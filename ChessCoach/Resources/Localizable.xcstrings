    "skill.opening.summary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwickle Figuren, besetze das Zentrum, rochiere früh."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Develop pieces, take the centre, castle early."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desarrolla las piezas, toma el centro, enroca pronto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Développez vos pièces, prenez le centre, roquez tôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sviluppa i pezzi, prendi il centro, arrocca presto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駒を展開し、中央を取り、早めにキャスリングすること。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기물을 전개하고 중앙을 차지하며 일찍 캐슬링하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontwikkel je stukken, neem het centrum, rokeer vroeg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozwijaj figury, zajmij centrum, roszuj wcześnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenvolva as peças, tome o centro, role cedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Развивайте фигуры, занимайте центр, рокируйтесь рано."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşları geliştirin, merkezi alın, erken rok yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розвивайте фігури, займайте центр, рокіруйтеся рано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出动棋子，控制中心，尽早易位。"
          }
        }
      }
    },
