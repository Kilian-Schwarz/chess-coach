    "Set up an AI server in the settings (⌘,) for a written summary with three lessons.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine schriftliche Zusammenfassung mit drei Lehren in den Einstellungen (⌘,) einen KI-Server einrichten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura un servidor de IA en los ajustes (⌘,) para obtener un resumen escrito con tres lecciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez un serveur d’IA dans les réglages (⌘,) pour obtenir un résumé écrit avec trois leçons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta un server IA nelle impostazioni (⌘,) per un riepilogo scritto con tre lezioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "三つの教訓を含む文章の要約を表示するには、設定(⌘,)で AI サーバーを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 가지 교훈이 담긴 서면 요약을 받으려면 설정(⌘,)에서 AI 서버를 지정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel in de instellingen (⌘,) een AI-server in voor een schriftelijke samenvatting met drie lessen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skonfiguruj serwer AI w ustawieniach (⌘,), aby otrzymać pisemne podsumowanie z trzema lekcjami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure um servidor de IA nos ajustes (⌘,) para receber um resumo escrito com três lições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для письменного итога с тремя уроками настройте сервер ИИ в настройках (⌘,)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç dersli yazılı bir özet için ayarlarda (⌘,) bir yapay zekâ sunucusu ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
