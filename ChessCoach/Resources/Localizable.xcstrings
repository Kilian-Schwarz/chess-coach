        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwaga: %1$@ na %2$@ może zostać zbity przez tańszą figurę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuidado: %1$@ em %2$@ poderia ser capturada por uma peça de menor valor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осторожно: %1$@ на %2$@ может быть взята более дешёвой фигурой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikkat: %2$@ karesindeki %1$@ daha değersiz bir taş tarafından alınabilir."
