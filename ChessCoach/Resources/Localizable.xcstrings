            "state": "translated",
            "value": "Переместить Chess Coach в папку «Программы»?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess Coach Uygulamalar klasörüne taşınsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
