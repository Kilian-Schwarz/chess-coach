    "Take a moment to think, then press again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Denk kurz nach, dann drück noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a moment to think, then press again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Piénsalo un momento y vuelve a pulsar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réfléchissez un instant, puis appuyez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rifletti un momento, poi premi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し考えてから、もう一度押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 생각한 뒤 다시 눌러 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Denk even na en druk dan nog een keer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomyśl chwilę, a potem naciśnij ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pense um instante e pressione de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подумайте немного, затем нажмите ещё раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biraz düşün, sonra tekrar bas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подумайте хвилинку, потім натисніть ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先想一想，再按一次。"
          }
        }
      }
    },
    "No immediate threat found.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
