    "Click or drag a piece to play your move.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke oder ziehe eine Figur, um deinen Zug zu spielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic o arrastra una pieza para jugar tu movimiento."
          }
        },
