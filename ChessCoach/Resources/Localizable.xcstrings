    "No model list found at this address. For Open WebUI enter the site address, for vLLM use http://host:8000/v1.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter dieser Adresse wurde keine Modellliste gefunden. Für Open WebUI die Adresse der Seite eintragen, für vLLM http://host:8000/v1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró una lista de modelos en esta dirección. Para Open WebUI introduce la dirección del sitio; para vLLM, http://host:8000/v1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune liste de modèles à cette adresse. Pour Open WebUI, saisissez l’adresse du site ; pour vLLM, http://host:8000/v1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun elenco di modelli a questo indirizzo. Per Open WebUI inserisci l’indirizzo del sito, per vLLM http://host:8000/v1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスにモデル一覧が見つかりません。Open WebUI ではサイトのアドレス、vLLM では http://host:8000/v1 を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주소에서 모델 목록을 찾을 수 없습니다. Open WebUI는 사이트 주소를, vLLM은 http://host:8000/v1을 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dit adres is geen modellenlijst gevonden. Voer voor Open WebUI het siteadres in, voor vLLM http://host:8000/v1."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod tym adresem nie znaleziono listy modeli. Dla Open WebUI wpisz adres strony, dla vLLM http://host:8000/v1."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma lista de modelos encontrada neste endereço. Para o Open WebUI informe o endereço do site; para o vLLM, http://host:8000/v1."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По этому адресу список моделей не найден. Для Open WebUI укажите адрес сайта, для vLLM — http://host:8000/v1."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adreste model listesi bulunamadı. Open WebUI için sitenin adresini, vLLM için http://host:8000/v1 girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За цією адресою список моделей не знайдено. Для Open WebUI вкажіть адресу сайту, для vLLM — http://host:8000/v1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此地址下未找到模型列表。Open WebUI 请填写网站地址，vLLM 请使用 http://host:8000/v1。"
          }
        }
      }
    },
