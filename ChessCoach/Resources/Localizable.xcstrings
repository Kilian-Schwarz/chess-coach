    "skill.tactics.summary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkenne und nutze Gabeln, Fesselungen, Spieße und Abzugsangriffe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot and use forks, pins, skewers and discovered attacks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta y usa horquillas, clavadas, rayos X y ataques descubiertos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repérez et utilisez fourchettes, clouages, enfilades et attaques à la découverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Individua e sfrutta forchette, inchiodature, infilate e attacchi di scoperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーク、ピン、スキュアー、ディスカバードアタックを見つけて活用すること。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포크, 핀, 스큐어, 디스커버드 어택을 찾아 활용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herken en gebruik vorken, aanvallen op een pin, spiesen en ontdekte aanvallen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostrzegaj i wykorzystuj widełki, związania, przeszycia i ataki odkryte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifique e use garfos, cravadas, raios X e ataques descobertos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замечайте и используйте вилки, связки, сквозные удары и вскрытые атаки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çatalları, bağlamaları, şiş taktiklerini ve açık saldırıları fark edip kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помічайте й використовуйте вилки, зв’язки, наскрізні удари та відкриті атаки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现并运用双重攻击、牵制、串击和闪击。"
          }
        }
      }
    },
