    "lift.cheaper": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorsicht: %1$@ auf %2$@ könnte von einer billigeren Figur geschlagen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
