    "Everything due is done. %lld of %lld tasks mastered.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles Fällige ist erledigt. %lld von %lld Aufgaben gemeistert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo pendiente está hecho. %lld de %lld tareas dominadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui était à faire est fait. %lld exercices maîtrisés sur %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto il dovuto è fatto. %lld esercizi su %lld padroneggiati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限の課題はすべて完了。%lld/%lld 件を習得済み。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해야 할 과제를 모두 끝냈습니다. %lld/%lld개 숙달."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat aan de beurt was is klaar. %lld van %lld opgaven beheerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko na dziś zrobione. Opanowano %lld z %lld zadań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que estava pendente foi feito. %lld de %lld tarefas dominadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что нужно, сделано. Освоено задач: %lld из %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanı gelenlerin hepsi bitti. %lld görevden %lld tanesi ustalaşıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе, що потрібно, виконано. Засвоєно завдань: %lld з %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到期任务已全部完成。已掌握 %lld/%lld 个任务。"
          }
        }
      }
    },
