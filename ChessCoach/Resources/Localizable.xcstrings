    "The app learns from your buttons, from tasks solved after an explanation, and from asking again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App lernt aus deinen Knöpfen, aus Aufgaben, die nach einer Erklärung gelöst werden, und aus Nachfragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app aprende de tus botones, de las tareas resueltas tras una explicación y de las preguntas repetidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app apprend de vos boutons, des exercices résolus après une explication et des demandes répétées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app impara dai tuoi pulsanti, dagli esercizi risolti dopo una spiegazione e dalle domande ripetute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは、ボタン操作、解説後に解いた課題、再質問から学習します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 버튼 선택, 설명 후 푼 과제, 다시 묻기를 통해 학습합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app leert van je knoppen, van opgaven die na een uitleg zijn opgelost en van nogmaals vragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja uczy się z twoich przycisków, z zadań rozwiązanych po wyjaśnieniu i z ponownych pytań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app aprende com seus botões, com tarefas resolvidas após uma explicação e com perguntas repetidas."
