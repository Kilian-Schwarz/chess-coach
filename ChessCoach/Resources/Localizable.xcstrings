    "You used a hint, so the task comes back at the same interval.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast einen Hinweis genutzt, deshalb kommt die Aufgabe im selben Abstand wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usaste una pista, así que la tarea vuelve con el mismo intervalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez utilisé un indice : l’exercice reviendra au même intervalle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai usato un suggerimento, quindi l’esercizio ritorna con lo stesso intervallo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒントを使ったため、同じ間隔で再出題されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "힌트를 사용했으므로 같은 간격으로 다시 나옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gebruikte een hint, dus de opgave komt na hetzelfde interval terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyto wskazówki, więc zadanie wróci w tym samym odstępie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você usou uma dica, então a tarefa volta no mesmo intervalo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы использовали подсказку, поэтому задача вернётся с тем же интервалом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu kullandınız, bu yüzden görev aynı aralıkla geri gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви використали підказку, тому завдання повернеться з тим самим інтервалом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你使用了提示，因此该任务会按相同间隔再次出现。"
          }
        }
      }
    },
