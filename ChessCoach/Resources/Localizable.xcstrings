    "skill.middlegame.summary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Habe im Mittelspiel einen Plan: Figuren verbessern, Schwächen angreifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have a plan in the middlegame: improve pieces, attack weaknesses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten un plan en el medio juego: mejora las piezas y ataca las debilidades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayez un plan au milieu de partie : améliorez vos pièces, attaquez les faiblesses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbi un piano nel mediogioco: migliora i pezzi, attacca le debolezze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミドルゲームでは計画を持つこと。駒を活用し、弱点を攻めること。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미들게임에서는 계획을 세우세요. 기물을 개선하고 약점을 공격하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb een plan in het middenspel: verbeter je stukken, val zwakke punten aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miej plan w grze środkowej: poprawiaj figury, atakuj słabości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenha um plano no meio-jogo: melhore as peças, ataque as fraquezas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имейте план в миттельшпиле: улучшайте фигуры, атакуйте слабости."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orta oyunda bir planınız olsun: taşları geliştirin, zayıflıklara saldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Майте план у міттельшпілі: покращуйте фігури, атакуйте слабкості."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中局要有计划：改善棋子位置，攻击弱点。"
          }
        }
      }
    },
