    "skill.kingSafety.summary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den König geschützt und schwäche seine Deckung nicht ohne Not."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the king protected and do not weaken its cover without need."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el rey protegido y no debilites su cobertura sin necesidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le roi protégé et n’affaiblissez pas sa couverture sans nécessité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni il re protetto e non indebolire la sua copertura senza necessità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キングを守り、理由なくその守りを崩さないこと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "킹을 안전하게 지키고 이유 없이 방어를 약화시키지 마세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de koning beschermd en verzwak zijn dekking niet zonder reden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chroń króla i nie osłabiaj jego osłony bez potrzeby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o rei protegido e não enfraqueça sua cobertura sem necessidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите короля в безопасности и не ослабляйте его прикрытие без нужды."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şahı koruyun ve gereksiz yere korumasını zayıflatmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте короля в безпеці й не послаблюйте його прикриття без потреби."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护好王，不要无故削弱它的掩护。"
          }
        }
      }
    },
