    "No big swings. A clean game.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine großen Ausschläge. Eine saubere Partie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin grandes vaivenes. Una partida limpia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de grands retournements. Une partie propre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna grande oscillazione. Una partita pulita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きな変動はありません。きれいな対局です。"
