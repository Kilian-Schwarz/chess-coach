    "skill.pieceSafety.summary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass nie eine Figur ungedeckt oder ungeschützt stehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never leave a piece undefended or unprotected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca dejes una pieza sin defensa ni protección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne laissez jamais une pièce sans défense ni protection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non lasciare mai un pezzo indifeso o non protetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駒を無防備のまま放置しないこと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기물을 지키지 않은 채 두지 마세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat nooit een stuk onverdedigd of onbeschermd staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy nie zostawiaj figury bez obrony ani ochrony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca deixe uma peça sem defesa ou proteção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не оставляйте фигуру без защиты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir taşı savunmasız veya korumasız bırakmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніколи не залишайте фігуру без захисту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绝不要让棋子无人保护。"
          }
        }
      }
    },
