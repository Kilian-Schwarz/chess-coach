          }
        }
      }
    },
    "Chess Coach is running from outside the Applications folder. Moving it there keeps it in one place and lets it update itself.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess Coach läuft nicht aus dem Ordner „Programme“. Dort liegt die App an einem festen Platz und kann sich selbst aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess Coach se está ejecutando fuera de la carpeta Aplicaciones. Al moverlo allí queda en un solo lugar y puede actualizarse solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess Coach s’exécute depuis un autre dossier que Applications. Le déplacer au bon endroit le garde en un seul lieu et lui permet de se mettre à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess Coach è in esecuzione da fuori la cartella Applicazioni. Spostandolo lì resta in un posto solo e può aggiornarsi da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess Coach は「アプリケーション」フォルダ以外の場所から実行されています。移動すると保管場所が一つにまとまり、自動で更新できるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess Coach가 응용 프로그램 폴더 밖에서 실행되고 있습니다. 그곳으로 옮기면 한곳에 보관되고 스스로 업데이트할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess Coach draait buiten de map Programma’s. Als je het daarheen verplaatst, staat het op één plek en kan het zichzelf bijwerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess Coach działa spoza folderu Programy. Po przeniesieniu go tam aplikacja ma stałe miejsce i może sama się aktualizować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Chess Coach está sendo executado fora da pasta Aplicativos. Movendo-o para lá, ele fica em um só lugar e pode se atualizar sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess Coach запущен не из папки «Программы». Если переместить его туда, приложение будет лежать в одном месте и сможет обновляться само."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess Coach, Uygulamalar klasörünün dışından çalışıyor. Oraya taşımak onu tek bir yerde tutar ve kendini güncellemesini sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess Coach запущено не з папки «Програми». Якщо перемістити його туди, застосунок лежатиме в одному місці й зможе оновлюватися сам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess Coach 当前不在“应用程序”文件夹中运行。移到该文件夹后，它会固定在一个位置并可自动更新。"
          }
        }
      }
    },
