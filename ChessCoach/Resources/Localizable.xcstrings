    "skill.threats.summary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe vor jedem Zug, was der Gegner vorhat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before every move, check what the opponent is up to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de cada jugada, comprueba qué prepara el rival."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant chaque coup, vérifiez ce que prépare l’adversaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di ogni mossa controlla cosa prepara l’avversario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指す前に、相手の狙いを確認すること。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수를 두기 전에 상대가 무엇을 노리는지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer vóór elke zet wat de tegenstander van plan is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed każdym ruchem sprawdź, co szykuje przeciwnik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de cada lance, veja o que o adversário prepara."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед каждым ходом проверяйте, что задумал соперник."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her hamleden önce rakibin ne planladığına bakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед кожним ходом перевіряйте, що задумав суперник."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每走一步之前，先看看对手想做什么。"
          }
        }
