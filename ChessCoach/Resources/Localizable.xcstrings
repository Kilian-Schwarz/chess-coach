    "The server address starts with http://. Your token would be sent unencrypted. Use https:// if you can.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Serveradresse beginnt mit http://. Dein Token würde unverschlüsselt gesendet. Nimm https://, wenn möglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server address starts with http://. Your token would be sent unencrypted. Use https:// if you can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección del servidor empieza por http://. Tu token se enviaría sin cifrar. Usa https:// si puedes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adresse du serveur commence par http://. Votre jeton serait envoyé sans chiffrement. Utilisez https:// si possible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indirizzo del server inizia con http://. Il tuo token verrebbe inviato senza cifratura. Usa https:// se puoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーのアドレスが http:// で始まっています。トークンは暗号化されずに送信されます。可能なら https:// を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 주소가 http://로 시작합니다. 토큰이 암호화되지 않은 채 전송됩니다. 가능하면 https://를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het serveradres begint met http://. Je token wordt onversleuteld verzonden. Gebruik https:// als het kan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres serwera zaczyna się od http://. Twój token zostałby wysłany bez szyfrowania. Użyj https://, jeśli to możliwe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço do servidor começa com http://. Seu token seria enviado sem criptografia. Use https:// se puder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес сервера начинается с http://. Ваш токен будет отправлен без шифрования. По возможности используйте https://."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu adresi http:// ile başlıyor. Jetonunuz şifrelenmeden gönderilir. Mümkünse https:// kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адреса сервера починається з http://. Ваш токен буде надіслано без шифрування. Якщо можливо, використовуйте https://."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器地址以 http:// 开头。您的令牌将以未加密方式发送。如有可能，请使用 https://。"
          }
        }
      }
    },
