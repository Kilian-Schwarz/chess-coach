    "skill.endgame.summary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere den König, wandle Bauern um, gewinne einfache Endspiele sicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activate the king, promote pawns, win simple endgames safely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el rey, corona peones y gana con seguridad los finales sencillos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le roi, promouvez les pions, gagnez sûrement les finales simples."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva il re, promuovi i pedoni, vinci con sicurezza i finali semplici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キングを活用し、ポーンを昇格させ、簡単なエンドゲームを確実に勝つこと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "킹을 활성화하고 폰을 승급시켜 단순한 엔드게임을 안전하게 이기세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Activeer de koning, promoveer pionnen, win eenvoudige eindspelen veilig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywizuj króla, promuj piony, pewnie wygrywaj proste końcówki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o rei, promova peões e vença com segurança finais simples."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активизируйте короля, проводите пешки, надёжно выигрывайте простые эндшпили."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şahı aktifleştirin, piyonları terfi ettirin, basit oyun sonlarını güvenle kazanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активізуйте короля, проводьте пішаки, надійно вигравайте прості ендшпілі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激活王，升变兵，稳妥地赢下简单残局。"
          }
        }
      }
    },
