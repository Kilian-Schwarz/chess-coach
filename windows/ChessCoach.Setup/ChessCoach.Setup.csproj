<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>ChessCoach.Setup</RootNamespace>
    <AssemblyName>ChessCoach-Setup</AssemblyName>
    <ApplicationIcon>..\ChessCoach.App\Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en;de;fr;es;it;pt-BR;nl;pl;tr;ru;uk;zh-Hans;ja;ko</SatelliteResourceLanguages>
    <Version>0.1.1</Version>
    <DebugType>none</DebugType>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>
</Project>
